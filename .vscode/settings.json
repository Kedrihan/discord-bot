{
  // Active l'analyse sémantique Roslyn de C#
  "csharp.semanticHighlighting.enabled": true,
  "editor.semanticHighlighting.enabled": true,

  // Thème de base compatible
  "workbench.colorTheme": "Dark+",

  // --- Coloration Sémantique Visual Studio 2022 (.NET) ---
  "editor.semanticTokenColorCustomizations": {
    "[Default Dark+]": {
      "rules": {
        "class": "#4EC9B0",
        "record": "#4EC9B0",
        "struct": "#86C691",
        "interface": "#B8D7A3",
        "enum": "#B8D7A3",
        "enumMember": "#B8D7A3",
        "typeParameter": "#B8D7A3",
        "delegate": "#4EC9B0",
        "method": "#DCDCAA",
        "extensionMethod": "#DCDCAA",
        "property": "#DCDCDC",
        "field": "#DCDCDC",
        "parameter": "#9CDCFE",
        "local": "#9CDCFE",
        "controlKeyword": "#D8A0DF"
      }
    }
  },

  // --- Règles TextMate spécifiques pour coller au rendu exact Visual Studio ---
  "editor.tokenColorCustomizations": {
    "[Default Dark+]": {
      "comments": "#57A64A",
      "strings": "#D69D85",
      "numbers": "#B5CEA8",
      "keywords": "#569CD6",
      "textMateRules": [
        {
          "name": "Mots-clés de contrôle C# (if, return, await, foreach...) en violet Visual Studio",
          "scope": [
            "keyword.control.cs",
            "keyword.control.flow.cs",
            "keyword.control.conditional.cs",
            "keyword.control.loop.cs",
            "keyword.control.async.cs",
            "keyword.control.try-catch.cs"
          ],
          "settings": {
            "foreground": "#D8A0DF"
          }
        },
        {
          "name": "Directives préprocesseur (#region, #if, etc.)",
          "scope": [
            "meta.preprocessor.cs",
            "keyword.control.directive.cs"
          ],
          "settings": {
            "foreground": "#9B9B9B"
          }
        },
        {
          "name": "Commentaires XML Doc (///)",
          "scope": [
            "comment.block.documentation.cs",
            "comment.line.documentation.cs"
          ],
          "settings": {
            "foreground": "#608B4E"
          }
        },
        {
          "name": "Caractères d'échappement et interpolation ($ et {})",
          "scope": [
            "constant.character.escape.cs",
            "punctuation.definition.interpolation.begin.cs",
            "punctuation.definition.interpolation.end.cs"
          ],
          "settings": {
            "foreground": "#FFD68F"
          }
        }
      ]
    }
  },

  // Configuration de l'éditeur pour C#
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  }
}
