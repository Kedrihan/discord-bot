# Token secret de votre bot Discord (obtenu sur https://discord.com/developers/applications)
DISCORD_TOKEN=votre_token_secret_ici

# Optionnel : ID de votre serveur Discord pour enregistrer les commandes immédiatement en développement
DISCORD_GUILD_ID=

# Authentification Discord OAuth2 pour sécuriser le Dashboard
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ADMIN_USER_ID=116893981526196227

# Clé API Google Gemini pour la synthèse IA (obtenue sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=
