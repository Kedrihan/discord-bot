@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject DiscordSocketClient DiscordClient

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: 70vh;">
    <div class="card p-4 p-md-5 text-center shadow-lg border-0" style="max-width: 480px; width: 100%;">
        @if (OAuthStatus == "not_configured")
        {
            <div class="alert alert-warning py-2 px-3 small mb-4" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> L'authentification Discord OAuth n'est pas configurée sur ce serveur.
            </div>
        }

        <div class="mb-3">
            @{
                var avatarUrl = DiscordClient.CurrentUser?.GetAvatarUrl(size: 128);
            }
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="@avatarUrl" alt="@(DiscordClient.CurrentUser?.Username ?? "Discord Bot")" class="rounded-circle shadow" width="96" height="96" />
            }
            else
            {
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow" style="width: 96px; height: 96px; background-color: var(--discord-dark); border: 2px solid var(--discord-border);">
                    <i class="bi bi-discord text-primary" style="font-size: 3rem;"></i>
                </div>
            }
        </div>

        <h2 class="fw-bold mb-2">@(DiscordClient.CurrentUser?.Username ?? "Discord Bot")</h2>

        <div class="mb-3">
            @if (DiscordClient.ConnectionState == ConnectionState.Connected)
            {
                <span class="badge badge-online px-3 py-2 fs-6 rounded-pill">
                    <i class="bi bi-broadcast me-1"></i> En ligne
                </span>
            }
            else
            {
                <span class="badge badge-offline px-3 py-2 fs-6 rounded-pill">
                    <i class="bi bi-exclamation-circle me-1"></i> @DiscordClient.ConnectionState
                </span>
            }
        </div>

        <p class="text-secondary mb-4">
            Interface d'administration et de gestion centralisée du bot Discord.
        </p>

        <div class="d-flex flex-column align-items-center gap-2">
            <AuthorizeView Policy="AdminOnly">
                <Authorized>
                    <a href="/dashboard" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-speedometer2 me-2"></i>Accéder au Dashboard
                    </a>
                </Authorized>
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-warning d-flex align-items-center justify-content-center gap-2 py-2 px-3 mb-2 small w-100" role="alert">
                            <i class="bi bi-shield-exclamation fs-5"></i>
                            <span>Compte Discord non autorisé (réservé à l'administrateur)</span>
                        </div>
                        <a href="/logout" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Se déconnecter
                        </a>
                    }
                    else
                    {
                        <a href="/login" class="btn btn-discord btn-lg px-4">
                            <i class="bi bi-discord me-2"></i>Se connecter avec Discord
                        </a>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "oauth")]
    public string? OAuthStatus { get; set; }

    protected override void OnInitialized()
    {
        DiscordClient.Connected += OnClientStateChangedAsync;
        DiscordClient.Disconnected += OnClientDisconnectedAsync;
    }

    private Task OnClientStateChangedAsync() => InvokeAsync(StateHasChanged);
    private Task OnClientDisconnectedAsync(Exception ex) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DiscordClient.Connected -= OnClientStateChangedAsync;
        DiscordClient.Disconnected -= OnClientDisconnectedAsync;
    }
}
