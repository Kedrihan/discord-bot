@page "/embeds"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminAccess")]
@rendermode InteractiveServer
@inject EmbedTemplateService TemplateService
@inject TwitchConfigService TwitchConfig
@inject YouTubeConfigService YouTubeConfig
@inject DiscordSocketClient DiscordClient
@inject PermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="container-fluid py-3" style="max-width: 1400px;">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-card-heading text-info"></i>
                <span>Personnalisation des Modèles d'Embeds Discord</span>
            </h3>
            <p class="text-secondary mb-0">Configurez l'apparence des alertes Discord pour Twitch Live, Twitch Clips et YouTube avec prévisualisation en direct.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/twitch" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-twitch" style="color: #9146FF;"></i> Configuration Twitch
            </a>
            <a href="/youtube" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-youtube" style="color: #FF0000;"></i> Configuration YouTube
            </a>
        </div>
    </div>

    <!-- Alertes Feedback -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(isSuccessFeedback ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5"></i>
            <div class="flex-grow-1">@feedbackMessage</div>
            <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
        </div>
    }

    <!-- Onglets de sélection du type de notification -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <button class="nav-link d-flex align-items-center gap-2 @(selectedType == EmbedTemplateTypeDto.TwitchLive ? "active bg-primary" : "")"
                    @onclick="() => ChangeTypeAsync(EmbedTemplateTypeDto.TwitchLive)">
                <i class="bi bi-broadcast" style="color: #9146FF;"></i>
                <span class="fw-semibold">Twitch Live</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link d-flex align-items-center gap-2 @(selectedType == EmbedTemplateTypeDto.TwitchClip ? "active bg-primary" : "")"
                    @onclick="() => ChangeTypeAsync(EmbedTemplateTypeDto.TwitchClip)">
                <i class="bi bi-film" style="color: #9146FF;"></i>
                <span class="fw-semibold">Twitch Clips</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link d-flex align-items-center gap-2 @(selectedType == EmbedTemplateTypeDto.YouTubeVideo ? "active bg-primary" : "")"
                    @onclick="() => ChangeTypeAsync(EmbedTemplateTypeDto.YouTubeVideo)">
                <i class="bi bi-youtube" style="color: #FF0000;"></i>
                <span class="fw-semibold">YouTube Vidéos</span>
            </button>
        </li>
    </ul>

    <!-- Sélecteur de Portée (Scope) : Global vs Surcharge Serveur/Chaîne -->
    <div class="card bg-dark border-secondary border-opacity-50 mb-4 shadow-sm">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label class="form-label fw-bold mb-1 small text-secondary">Portée du modèle</label>
                    <select class="form-select form-select-sm" @onchange="OnScopeModeChanged">
                        @if (isSuperAdmin)
                        {
                            <option value="global" selected="@(isGlobalScope)">🌐 Modèle global (par défaut)</option>
                        }
                        <option value="override" selected="@(!isGlobalScope)">🎯 Surcharge spécifique (Serveur / Chaîne)</option>
                    </select>
                </div>

                @if (!isGlobalScope)
                {
                    <div class="col-md-4">
                        <label class="form-label fw-bold mb-1 small text-secondary">Serveur Discord</label>
                        <select class="form-select form-select-sm" value="@selectedGuildId" @onchange="OnGuildChangedAsync">
                            <option value="">-- Choisir un serveur --</option>
                            @foreach (var guild in GetAvailableGuilds())
                            {
                                <option value="@guild.Id">@guild.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-bold mb-1 small text-secondary">
                            @(selectedType == EmbedTemplateTypeDto.YouTubeVideo ? "Chaîne YouTube" : "Streamer Twitch")
                        </label>
                        <select class="form-select form-select-sm" value="@selectedTargetId" @onchange="OnTargetChangedAsync">
                            <option value="">-- Modèle pour tout le serveur (sans chaîne spécifique) --</option>
                            @foreach (var target in GetAvailableTargets())
                            {
                                <option value="@target.Id">@target.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Interface principale : Éditeur à gauche (8 cols) & Prévisualisation à droite (4 cols) -->
    <div class="row g-4">
        <!-- Éditeur de Modèle -->
        <div class="col-lg-7 col-xl-7">
            <div class="card bg-dark border-secondary border-opacity-50 shadow-sm h-100">
                <div class="card-header border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-primary"></i>
                        <span>Configuration du Modèle</span>
                    </h5>
                    <button class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" @onclick="ResetToDefaultsAsync" title="Réinitialiser aux valeurs d'origine">
                        <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                    </button>
                </div>
                <div class="card-body">
                    <!-- Variables disponibles -->
                    <div class="mb-4 p-3 rounded bg-black bg-opacity-25 border border-secondary border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small fw-bold text-secondary text-uppercase">
                                <i class="bi bi-braces me-1"></i>Variables dynamiques disponibles (cliquez pour insérer dans le titre)
                            </span>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var variable in TemplateService.GetAvailableVariables(selectedType))
                            {
                                <button type="button" class="btn btn-sm btn-outline-info py-0 px-2 font-monospace"
                                        style="font-size: 0.75rem;"
                                        title="@variable.Description (Ex: @variable.ExampleValue)"
                                        @onclick="() => AppendVariableToTitle(variable.VariableName)">
                                    @variable.VariableName
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Couleur & Auteur -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small text-light">Couleur de l'Embed</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" class="form-control form-control-color" value="@editColorHex" @onchange="OnColorChanged" title="Choisir une couleur" />
                                <input type="text" class="form-control form-control-sm font-monospace" maxlength="7" value="@editColorHex" @onchange="OnColorHexInput" />
                            </div>
                            <div class="d-flex gap-1 mt-2">
                                <span class="badge cursor-pointer" style="background-color: #9146FF; cursor: pointer;" @onclick='() => SetColor("#9146FF")'>Twitch</span>
                                <span class="badge cursor-pointer" style="background-color: #FF0000; cursor: pointer;" @onclick='() => SetColor("#FF0000")'>YouTube</span>
                                <span class="badge cursor-pointer" style="background-color: #5865F2; cursor: pointer;" @onclick='() => SetColor("#5865F2")'>Blurple</span>
                                <span class="badge cursor-pointer" style="background-color: #57F287; cursor: pointer;" @onclick='() => SetColor("#57F287")'>Vert</span>
                                <span class="badge cursor-pointer" style="background-color: #FEE75C; color: black; cursor: pointer;" @onclick='() => SetColor("#FEE75C")'>Or</span>
                                <span class="badge cursor-pointer" style="background-color: #EB459E; cursor: pointer;" @onclick='() => SetColor("#EB459E")'>Rose</span>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="form-label fw-semibold small text-light mb-0">En-tête / Auteur</label>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="authorSwitch" checked="@editEnableAuthor" @onchange="e => editEnableAuthor = (bool)(e.Value ?? true)" />
                                    <label class="form-check-label small" for="authorSwitch">Afficher</label>
                                </div>
                            </div>
                            <input type="text" class="form-control form-control-sm" placeholder="{StreamerName} ou {ChannelName}"
                                   disabled="@(!editEnableAuthor)" value="@editAuthorNameTemplate" @oninput="e => editAuthorNameTemplate = e.Value?.ToString() ?? string.Empty" />
                            <div class="form-text small">Nom de l'auteur affiché en haut de l'embed.</div>
                        </div>
                    </div>

                    <!-- Titre & Description -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-light">Modèle de Titre (max 256 car.)</label>
                        <input type="text" class="form-control form-control-sm" maxlength="256"
                               placeholder="Ex: {StreamTitle} ou {VideoTitle}"
                               value="@editTitleTemplate" @oninput="e => editTitleTemplate = e.Value?.ToString() ?? string.Empty" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-light">Modèle de Description (Markdown)</label>
                        <textarea class="form-control form-control-sm" rows="3" maxlength="4096"
                                  placeholder="Description optionnelle (supporte les variables et le markdown)..."
                                  value="@editDescriptionTemplate" @oninput="e => editDescriptionTemplate = e.Value?.ToString() ?? string.Empty"></textarea>
                    </div>

                    <!-- Pied de page, Image et Date -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-light">Pied de page (Footer)</label>
                            <input type="text" class="form-control form-control-sm" maxlength="2048"
                                   placeholder="Ex: Twitch Live Notifications"
                                   value="@editFooterTemplate" @oninput="e => editFooterTemplate = e.Value?.ToString() ?? string.Empty" />
                        </div>

                        <div class="col-md-6 d-flex align-items-center gap-4 pt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="thumbSwitch" checked="@editShowThumbnail" @onchange="e => editShowThumbnail = (bool)(e.Value ?? true)" />
                                <label class="form-check-label small" for="thumbSwitch">Bannière / Miniature</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="timeSwitch" checked="@editShowTimestamp" @onchange="e => editShowTimestamp = (bool)(e.Value ?? true)" />
                                <label class="form-check-label small" for="timeSwitch">Horodatage</label>
                            </div>
                        </div>
                    </div>

                    <!-- Champs personnalisés (Custom Fields) -->
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="fw-bold mb-0 text-light d-flex align-items-center gap-2">
                                <i class="bi bi-ui-checks-grid text-info"></i>
                                <span>Champs de l'Embed (@editFields.Count / 25)</span>
                            </h6>
                            @if (editFields.Count < 25)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="AddField">
                                    <i class="bi bi-plus-circle"></i> Ajouter un champ
                                </button>
                            }
                        </div>

                        @if (editFields.Count == 0)
                        {
                            <div class="text-secondary small fst-italic p-2 border border-secondary border-opacity-25 rounded text-center">
                                Aucun champ personnalisé configuré.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @for (int i = 0; i < editFields.Count; i++)
                                {
                                    var index = i;
                                    var field = editFields[index];
                                    <div class="p-2 rounded bg-black bg-opacity-25 border border-secondary border-opacity-25">
                                        <div class="row g-2 align-items-center">
                                            <div class="col-md-4">
                                                <input type="text" class="form-control form-control-sm" placeholder="Nom du champ" maxlength="256"
                                                       value="@field.Name" @oninput="e => UpdateFieldName(index, e.Value?.ToString() ?? string.Empty)" />
                                            </div>
                                            <div class="col-md-5">
                                                <input type="text" class="form-control form-control-sm" placeholder="Valeur (ex: {ViewerCount})" maxlength="1024"
                                                       value="@field.Value" @oninput="e => UpdateFieldValue(index, e.Value?.ToString() ?? string.Empty)" />
                                            </div>
                                            <div class="col-md-3 d-flex align-items-center justify-content-end gap-2">
                                                <div class="form-check form-check-inline mb-0" title="Aligner sur la même ligne">
                                                    <input class="form-check-input" type="checkbox" id="@($"inline_{index}")" checked="@field.Inline"
                                                           @onchange="e => UpdateFieldInline(index, (bool)(e.Value ?? true))" />
                                                    <label class="form-check-label small" for="@($"inline_{index}")">Ligne</label>
                                                </div>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary py-0 px-1" disabled="@(index == 0)" @onclick="() => MoveField(index, -1)">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-secondary py-0 px-1" disabled="@(index == editFields.Count - 1)" @onclick="() => MoveField(index, 1)">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger py-0 px-1" @onclick="() => RemoveField(index)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Boutons de Sauvegarde et Envoi de Test -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top border-secondary border-opacity-25">
                        <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-4" @onclick="SaveTemplateAsync" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Enregistrement...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle"></i>
                                <span>Enregistrer le modèle</span>
                            }
                        </button>

                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm" style="max-width: 250px;" @bind="testDiscordChannelId">
                                <option value="">-- Salon de test --</option>
                                @foreach (var ch in GetTestTargetChannels())
                                {
                                    <option value="@ch.Id">#@ch.Name (@ch.Guild.Name)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1"
                                    @onclick="SendTestEmbedAsync" disabled="@(isSendingTest || string.IsNullOrWhiteSpace(testDiscordChannelId))">
                                @if (isSendingTest)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                }
                                <span>Tester</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Prévisualisation en direct à droite -->
        <div class="col-lg-5 col-xl-5">
            <div class="sticky-top" style="top: 1rem;">
                <div class="card bg-dark border-secondary border-opacity-50 shadow-sm mb-3">
                    <div class="card-header border-secondary border-opacity-25 d-flex align-items-center gap-2">
                        <i class="bi bi-eye-fill text-success"></i>
                        <span class="fw-bold">Aperçu en direct (Discord Dark Mode)</span>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-center">
                        <DiscordEmbedPreview
                            Template="@CurrentPreviewTemplate"
                            Variables="@sampleData.Variables"
                            AuthorIconUrl="@sampleData.AuthorIconUrl"
                            AuthorUrl="@sampleData.AuthorUrl"
                            EmbedUrl="@sampleData.EmbedUrl"
                            ImageUrl="@sampleData.ImageUrl"
                            Timestamp="@sampleData.Timestamp" />
                    </div>
                </div>

                <div class="card bg-dark border-secondary border-opacity-50 p-3 text-secondary small">
                    <div class="fw-bold text-white mb-1"><i class="bi bi-info-circle me-1 text-info"></i> Astuce</div>
                    Les données de l'aperçu utilisent des exemples représentatifs. Lorsque la notification réelle est déclenchée, les valeurs des variables dynamiques sont automatiquement remplacées et assainies (protection contre les mentions non autorisées).
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }
    [SupplyParameterFromQuery(Name = "guildId")] public string? QueryGuildId { get; set; }
    [SupplyParameterFromQuery(Name = "targetId")] public string? QueryTargetId { get; set; }

    private EmbedTemplateTypeDto selectedType = EmbedTemplateTypeDto.TwitchLive;
    private bool isGlobalScope = true;
    private string selectedGuildId = string.Empty;
    private string selectedTargetId = string.Empty;

    private bool isSuperAdmin;
    private List<string> authorizedGuildIds = [];
    private System.Security.Claims.ClaimsPrincipal? currentUser;

    private string? feedbackMessage;
    private bool isSuccessFeedback;
    private bool isSaving;
    private bool isSendingTest;

    private string testDiscordChannelId = string.Empty;

    // Champs du formulaire d'édition
    private string editColorHex = "#9146FF";
    private string editTitleTemplate = string.Empty;
    private string editDescriptionTemplate = string.Empty;
    private bool editEnableAuthor = true;
    private string editAuthorNameTemplate = string.Empty;
    private string editFooterTemplate = string.Empty;
    private bool editShowThumbnail = true;
    private bool editShowTimestamp = true;
    private List<DiscordEmbedFieldTemplateDto> editFields = [];

    private (Dictionary<string, string> Variables, string? AuthorIconUrl, string? AuthorUrl, string? EmbedUrl, string? ImageUrl, DateTimeOffset Timestamp) sampleData;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User;
        isSuperAdmin = PermissionService.IsSuperAdmin(currentUser);
        authorizedGuildIds = PermissionService.GetAuthorizedGuildIds(currentUser, GuildFeatureFlagsDto.Twitch)
            .Union(PermissionService.GetAuthorizedGuildIds(currentUser, GuildFeatureFlagsDto.YouTube))
            .ToList();

        if (!isSuperAdmin)
        {
            isGlobalScope = false;
            if (!string.IsNullOrWhiteSpace(QueryGuildId) && authorizedGuildIds.Contains(QueryGuildId))
            {
                selectedGuildId = QueryGuildId;
                selectedTargetId = QueryTargetId ?? string.Empty;
            }
            else
            {
                selectedGuildId = authorizedGuildIds.FirstOrDefault() ?? string.Empty;
                selectedTargetId = string.Empty;
            }
        }
        else if (!string.IsNullOrWhiteSpace(QueryGuildId))
        {
            isGlobalScope = false;
            selectedGuildId = QueryGuildId;
            selectedTargetId = QueryTargetId ?? string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(QueryType) && Enum.TryParse<EmbedTemplateTypeDto>(QueryType, true, out var parsedType))
        {
            selectedType = parsedType;
        }

        await LoadCurrentTemplateAsync();
    }

    private async Task ChangeTypeAsync(EmbedTemplateTypeDto newType)
    {
        selectedType = newType;
        selectedTargetId = string.Empty;
        await LoadCurrentTemplateAsync();
    }

    private void OnScopeModeChanged(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString();
        isGlobalScope = isSuperAdmin && (mode == "global");
        if (isGlobalScope)
        {
            selectedGuildId = string.Empty;
            selectedTargetId = string.Empty;
        }
        else if (string.IsNullOrEmpty(selectedGuildId))
        {
            selectedGuildId = GetAvailableGuilds().FirstOrDefault()?.Id.ToString() ?? string.Empty;
        }
        _ = LoadCurrentTemplateAsync();
    }

    private async Task OnGuildChangedAsync(ChangeEventArgs e)
    {
        selectedGuildId = e.Value?.ToString() ?? string.Empty;
        selectedTargetId = string.Empty;
        await LoadCurrentTemplateAsync();
    }

    private async Task OnTargetChangedAsync(ChangeEventArgs e)
    {
        selectedTargetId = e.Value?.ToString() ?? string.Empty;
        await LoadCurrentTemplateAsync();
    }

    private async Task LoadCurrentTemplateAsync()
    {
        var gId = isGlobalScope ? string.Empty : selectedGuildId;
        var tId = isGlobalScope ? string.Empty : selectedTargetId;

        var template = await TemplateService.GetTemplateAsync(selectedType, gId, tId);

        editColorHex = string.IsNullOrWhiteSpace(template.ColorHex) ? "#9146FF" : template.ColorHex;
        editTitleTemplate = template.TitleTemplate;
        editDescriptionTemplate = template.DescriptionTemplate;
        editEnableAuthor = template.EnableAuthor;
        editAuthorNameTemplate = template.AuthorNameTemplate;
        editFooterTemplate = template.FooterTemplate;
        editShowThumbnail = template.ShowThumbnail;
        editShowTimestamp = template.ShowTimestamp;
        editFields = template.CustomFields?.Select(f => f with { }).ToList() ?? [];

        sampleData = TemplateService.GetSampleData(selectedType);

        if (string.IsNullOrEmpty(testDiscordChannelId))
        {
            testDiscordChannelId = GetTestTargetChannels().FirstOrDefault()?.Id.ToString() ?? string.Empty;
        }

        StateHasChanged();
    }

    private void AppendVariableToTitle(string token)
    {
        editTitleTemplate += (string.IsNullOrEmpty(editTitleTemplate) ? "" : " ") + token;
    }

    private void OnColorChanged(ChangeEventArgs e)
    {
        editColorHex = e.Value?.ToString() ?? "#9146FF";
    }

    private void OnColorHexInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim() ?? "#9146FF";
        if (!val.StartsWith('#') && val.Length == 6) val = "#" + val;
        editColorHex = val;
    }

    private void SetColor(string hex) => editColorHex = hex;

    private void AddField()
    {
        if (editFields.Count >= 25) return;
        editFields.Add(new DiscordEmbedFieldTemplateDto("Nouveau Champ", "{Valeur}", Inline: true, IsEnabled: true, Order: editFields.Count));
    }

    private void RemoveField(int index)
    {
        if (index >= 0 && index < editFields.Count)
        {
            editFields.RemoveAt(index);
            ReindexFields();
        }
    }

    private void MoveField(int index, int direction)
    {
        var targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= editFields.Count) return;

        var temp = editFields[index];
        editFields[index] = editFields[targetIndex];
        editFields[targetIndex] = temp;
        ReindexFields();
    }

    private void UpdateFieldName(int index, string name)
    {
        if (index >= 0 && index < editFields.Count)
        {
            editFields[index] = editFields[index] with { Name = name };
        }
    }

    private void UpdateFieldValue(int index, string value)
    {
        if (index >= 0 && index < editFields.Count)
        {
            editFields[index] = editFields[index] with { Value = value };
        }
    }

    private void UpdateFieldInline(int index, bool inline)
    {
        if (index >= 0 && index < editFields.Count)
        {
            editFields[index] = editFields[index] with { Inline = inline };
        }
    }

    private void ReindexFields()
    {
        for (int i = 0; i < editFields.Count; i++)
        {
            editFields[i] = editFields[i] with { Order = i };
        }
    }

    private static GuildFeatureFlagsDto GetRequiredFeature(EmbedTemplateTypeDto type) => type switch
    {
        EmbedTemplateTypeDto.TwitchLive or EmbedTemplateTypeDto.TwitchClip => GuildFeatureFlagsDto.Twitch,
        EmbedTemplateTypeDto.YouTubeVideo => GuildFeatureFlagsDto.YouTube,
        _ => GuildFeatureFlagsDto.None
    };

    private async Task SaveTemplateAsync()
    {
        var gId = isGlobalScope ? string.Empty : selectedGuildId;
        var tId = isGlobalScope ? string.Empty : selectedTargetId;

        if (isGlobalScope && !isSuperAdmin)
        {
            feedbackMessage = "Action non autorisée : seuls les administrateurs globaux peuvent modifier le modèle global.";
            isSuccessFeedback = false;
            return;
        }

        if (!isGlobalScope)
        {
            if (string.IsNullOrWhiteSpace(gId) || (!isSuperAdmin && !PermissionService.HasGuildFeatureAccess(currentUser!, gId, GetRequiredFeature(selectedType))))
            {
                feedbackMessage = "Action non autorisée : vous n'avez pas accès à ce serveur Discord.";
                isSuccessFeedback = false;
                return;
            }
        }

        isSaving = true;
        try
        {
            var dto = new DiscordEmbedTemplateDto
            {
                TemplateType = selectedType,
                GuildId = gId,
                ChannelTargetId = tId,
                ColorHex = editColorHex,
                TitleTemplate = editTitleTemplate,
                DescriptionTemplate = editDescriptionTemplate,
                EnableAuthor = editEnableAuthor,
                AuthorNameTemplate = editAuthorNameTemplate,
                FooterTemplate = editFooterTemplate,
                ShowThumbnail = editShowThumbnail,
                ShowTimestamp = editShowTimestamp,
                CustomFields = editFields
            };

            await TemplateService.SaveTemplateAsync(dto);
            feedbackMessage = "Modèle d'embed sauvegardé avec succès !";
            isSuccessFeedback = true;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Erreur lors de la sauvegarde : {ex.Message}";
            isSuccessFeedback = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResetToDefaultsAsync()
    {
        var gId = isGlobalScope ? string.Empty : selectedGuildId;
        var tId = isGlobalScope ? string.Empty : selectedTargetId;

        if (isGlobalScope && !isSuperAdmin)
        {
            feedbackMessage = "Action non autorisée : seuls les administrateurs globaux peuvent réinitialiser le modèle global.";
            isSuccessFeedback = false;
            return;
        }

        if (!isGlobalScope)
        {
            if (string.IsNullOrWhiteSpace(gId) || (!isSuperAdmin && !PermissionService.HasGuildFeatureAccess(currentUser!, gId, GetRequiredFeature(selectedType))))
            {
                feedbackMessage = "Action non autorisée : vous n'avez pas accès à ce serveur Discord.";
                isSuccessFeedback = false;
                return;
            }
        }

        if (!isGlobalScope)
        {
            await TemplateService.ResetTemplateAsync(selectedType, gId, tId);
        }

        var defaultDto = TemplateService.GetDefaultTemplate(selectedType);
        editColorHex = defaultDto.ColorHex;
        editTitleTemplate = defaultDto.TitleTemplate;
        editDescriptionTemplate = defaultDto.DescriptionTemplate;
        editEnableAuthor = defaultDto.EnableAuthor;
        editAuthorNameTemplate = defaultDto.AuthorNameTemplate;
        editFooterTemplate = defaultDto.FooterTemplate;
        editShowThumbnail = defaultDto.ShowThumbnail;
        editShowTimestamp = defaultDto.ShowTimestamp;
        editFields = defaultDto.CustomFields.Select(f => f with { }).ToList();

        if (isGlobalScope)
        {
            await TemplateService.SaveTemplateAsync(new DiscordEmbedTemplateDto
            {
                TemplateType = selectedType,
                GuildId = string.Empty,
                ChannelTargetId = string.Empty,
                ColorHex = editColorHex,
                TitleTemplate = editTitleTemplate,
                DescriptionTemplate = editDescriptionTemplate,
                EnableAuthor = editEnableAuthor,
                AuthorNameTemplate = editAuthorNameTemplate,
                FooterTemplate = editFooterTemplate,
                ShowThumbnail = editShowThumbnail,
                ShowTimestamp = editShowTimestamp,
                CustomFields = editFields
            });
        }

        feedbackMessage = "Modèle réinitialisé aux valeurs par défaut avec succès.";
        isSuccessFeedback = true;
    }

    private async Task SendTestEmbedAsync()
    {
        if (string.IsNullOrWhiteSpace(testDiscordChannelId))
        {
            feedbackMessage = "Veuillez choisir un salon Discord pour l'envoi du test.";
            isSuccessFeedback = false;
            return;
        }

        if (!isSuperAdmin && !PermissionService.CanManageDiscordChannel(currentUser!, testDiscordChannelId, GetRequiredFeature(selectedType)))
        {
            feedbackMessage = "Action non autorisée : vous ne disposez pas des permissions requises pour envoyer un test dans ce salon Discord.";
            isSuccessFeedback = false;
            return;
        }

        isSendingTest = true;
        try
        {
            var testTemplate = CurrentPreviewTemplate;
            var result = await TemplateService.SendTestEmbedAsync(selectedType, testTemplate, testDiscordChannelId);
            feedbackMessage = result.Message;
            isSuccessFeedback = result.Success;
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Erreur lors de l'envoi : {ex.Message}";
            isSuccessFeedback = false;
        }
        finally
        {
            isSendingTest = false;
        }
    }

    private DiscordEmbedTemplateDto CurrentPreviewTemplate => new()
    {
        TemplateType = selectedType,
        GuildId = isGlobalScope ? string.Empty : selectedGuildId,
        ChannelTargetId = isGlobalScope ? string.Empty : selectedTargetId,
        ColorHex = editColorHex,
        TitleTemplate = editTitleTemplate,
        DescriptionTemplate = editDescriptionTemplate,
        EnableAuthor = editEnableAuthor,
        AuthorNameTemplate = editAuthorNameTemplate,
        FooterTemplate = editFooterTemplate,
        ShowThumbnail = editShowThumbnail,
        ShowTimestamp = editShowTimestamp,
        CustomFields = editFields
    };

    private IEnumerable<SocketGuild> GetAvailableGuilds()
    {
        return DiscordClient.Guilds
            .Where(g => isSuperAdmin || authorizedGuildIds.Contains(g.Id.ToString()))
            .OrderBy(g => g.Name);
    }

    private record TargetOption(string Id, string Name);

    private IEnumerable<TargetOption> GetAvailableTargets()
    {
        if (string.IsNullOrEmpty(selectedGuildId)) return [];

        if (selectedType == EmbedTemplateTypeDto.YouTubeVideo)
        {
            var ytSettings = YouTubeConfig.GetSettings();
            return ytSettings.Channels
                .Where(c => c.GuildId == selectedGuildId)
                .Select(c => new TargetOption(c.ChannelId, string.IsNullOrWhiteSpace(c.ChannelTitle) ? c.ChannelId : c.ChannelTitle));
        }

        var twSettings = TwitchConfig.GetSettings();
        return twSettings.Channels
            .Where(c => c.GuildId == selectedGuildId)
            .Select(c => new TargetOption(c.TwitchUsername, c.TwitchUsername));
    }

    private IEnumerable<SocketTextChannel> GetTestTargetChannels()
    {
        var targetGuildId = !isGlobalScope && !string.IsNullOrEmpty(selectedGuildId)
            ? selectedGuildId
            : null;

        if (targetGuildId != null && ulong.TryParse(targetGuildId, out var gId))
        {
            var g = DiscordClient.GetGuild(gId);
            if (g != null) return g.TextChannels.OrderBy(c => c.Position);
        }

        return DiscordClient.Guilds
            .Where(g => isSuperAdmin || authorizedGuildIds.Contains(g.Id.ToString()))
            .SelectMany(g => g.TextChannels)
            .OrderBy(c => c.Guild.Name)
            .ThenBy(c => c.Position);
    }
}
