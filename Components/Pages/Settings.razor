@page "/settings"
@rendermode InteractiveServer

<div class="card p-5 shadow-sm mx-auto text-center" style="max-width: 700px;">
    <div class="mb-3">
        <i class="bi bi-sliders fs-1 text-primary"></i>
    </div>
    <h4 class="fw-bold mb-2">Paramètres du Bot</h4>
    <p class="text-secondary mb-4">
        Aucun paramètre configuré pour le moment. Cet espace accueillera les options de personnalisation au fur et à mesure du développement de votre bot.
    </p>
    <div>
        <a href="/" class="btn btn-discord px-4">
            <i class="bi bi-speedometer2 me-1"></i> Retour au Dashboard
        </a>
    </div>
</div>
