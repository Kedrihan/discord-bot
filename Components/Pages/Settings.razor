@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@inject TechWatchConfigService ConfigService
@inject TechWatchService TechWatchService
@inject DiscordSocketClient DiscordClient

<div class="container py-2" style="max-width: 900px;">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-newspaper text-primary me-2"></i>Veille Technologique</h3>
            <p class="text-secondary mb-0">Paramétrez la fréquence, les sujets, les sources et la synthèse IA pour votre récapitulatif Discord.</p>
        </div>
        <div class="form-check form-switch fs-4">
            <input class="form-check-input" type="checkbox" id="enableSwitch" @bind="settings.IsEnabled">
        </div>
    </div>

    <!-- Alertes de feedback -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi @(isSuccessFeedback ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5"></i>
            <div>@feedbackMessage</div>
            <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
        </div>
    }

    <!-- Aperçu du résultat d'un test -->
    @if (!string.IsNullOrEmpty(testPreviewContent))
    {
        <div class="card p-3 mb-4 border-info">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-info fw-bold mb-0"><i class="bi bi-send-check me-1"></i>Aperçu du message envoyé sur Discord</h6>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => testPreviewContent = null">Fermer</button>
            </div>
            <pre class="bg-dark p-3 rounded text-light mb-0 small" style="white-space: pre-wrap; font-family: monospace;">@testPreviewContent</pre>
        </div>
    }

    <div class="row g-4">
        <!-- 1. Planification & Cible -->
        <div class="col-md-6">
            <div class="card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2 text-warning"></i>Planification & Destinataire</h5>
                
                <!-- Heure d'envoi -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Heure d'envoi automatique</label>
                    <input type="time" class="form-control bg-dark text-light border-secondary" @bind="settings.ScheduleTime" />
                </div>

                <!-- Jours de la semaine -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary d-block">Jours d'envoi</label>
                    <div class="btn-group flex-wrap gap-1" role="group">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            var isSelected = settings.ScheduleDays.Contains(day);
                            <button type="button" 
                                    class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick="() => ToggleDay(day)">
                                @GetDayLabel(day)
                            </button>
                        }
                    </div>
                </div>

                <hr class="border-secondary my-3" />

                <!-- Type de destinataire -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary d-block">Destination Discord</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="destType" id="destDm" 
                               checked="@(settings.DestinationType == DestinationTypeDto.UserDm)"
                               @onchange="() => settings.DestinationType = DestinationTypeDto.UserDm">
                        <label class="form-check-label" for="destDm">Message Privé (MP)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="destType" id="destChan" 
                               checked="@(settings.DestinationType == DestinationTypeDto.Channel)"
                               @onchange="() => settings.DestinationType = DestinationTypeDto.Channel">
                        <label class="form-check-label" for="destChan">Salon de serveur</label>
                    </div>
                </div>

                <!-- ID Discord cible -->
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-secondary">
                        @(settings.DestinationType == DestinationTypeDto.UserDm ? "Identifiant Utilisateur (User ID)" : "Identifiant Salon (Channel ID)")
                    </label>
                    <input type="text" class="form-control bg-dark text-light border-secondary font-monospace" @bind="settings.TargetId" placeholder="ex: 116893981526196227" />
                    <div class="form-text text-secondary small">
                        @(settings.DestinationType == DestinationTypeDto.UserDm 
                            ? "Votre ID utilisateur Discord (clic droit sur votre profil > Copier l'identifiant)." 
                            : "L'ID du salon texte Discord où poster la veille.")
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Sources d'information -->
        <div class="col-md-6">
            <div class="card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-rss me-2 text-danger"></i>Sources d'informations</h5>
                
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="srcDevTo" @bind="settings.EnableDevTo">
                    <label class="form-check-label fw-semibold" for="srcDevTo">Dev.to (API REST)</label>
                    <div class="text-secondary small">Articles communautaires filtrés par vos tags.</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="srcHN" @bind="settings.EnableHackerNews">
                    <label class="form-check-label fw-semibold" for="srcHN">Hacker News (Algolia API)</label>
                    <div class="text-secondary small">Articles de fond tech, actualité internationale et IA.</div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="srcDotnet" @bind="settings.EnableDotnetBlogRss">
                    <label class="form-check-label fw-semibold" for="srcDotnet">Microsoft .NET Blog (RSS)</label>
                    <div class="text-secondary small">Annonces officielles .NET, C# et ASP.NET.</div>
                </div>

                <div class="mt-3">
                    <label class="form-label small fw-semibold text-secondary">Flux RSS personnalisés supplémentaires</label>
                    <div class="input-group input-group-sm mb-2">
                        <input type="url" class="form-control bg-dark text-light border-secondary" placeholder="https://exemple.com/feed.xml" @bind="newRssFeedUrl" />
                        <button class="btn btn-outline-primary" type="button" @onclick="AddCustomRss">Ajouter</button>
                    </div>
                    @if (settings.CustomRssFeeds.Count > 0)
                    {
                        <ul class="list-group list-group-flush bg-transparent small">
                            @foreach (var feed in settings.CustomRssFeeds)
                            {
                                <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center py-1 px-0">
                                    <span class="text-truncate" style="max-width: 280px;">@feed</span>
                                    <button class="btn btn-sm text-danger p-0 border-0" @onclick="() => RemoveCustomRss(feed)"><i class="bi bi-trash"></i></button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Sujets / Tags -->
        <div class="col-12">
            <div class="card p-4 shadow-sm">
                <h5 class="fw-bold mb-2"><i class="bi bi-tags me-2 text-info"></i>Thématiques & Sujets surveillés</h5>
                <p class="text-secondary small mb-3">Mots-clés et tags utilisés pour filtrer les articles sur les différentes sources.</p>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var topic in settings.Topics)
                    {
                        <span class="badge bg-secondary d-flex align-items-center gap-1 fs-6 px-3 py-2">
                            #@topic
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.65rem;" @onclick="() => RemoveTopic(topic)"></button>
                        </span>
                    }
                </div>

                <div class="input-group" style="max-width: 350px;">
                    <span class="input-group-text bg-dark text-secondary border-secondary">#</span>
                    <input type="text" class="form-control bg-dark text-light border-secondary" placeholder="Nouveau sujet (ex: rust, docker...)" @bind="newTopic" @bind:event="oninput" @onkeyup="HandleTopicKeyUp" />
                    <button class="btn btn-primary" type="button" @onclick="AddTopic">Ajouter</button>
                </div>
            </div>
        </div>

        <!-- 4. Configuration IA (Gemini) -->
        <div class="col-12">
            <div class="card p-4 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-robot me-2 text-success"></i>Synthèse & Traduction IA (Google Gemini)</h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Clé API Google Gemini</label>
                        <div class="input-group">
                            <input type="@(showApiKey ? "text" : "password")" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="AIzaSy..." @bind="settings.GeminiApiKey" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => showApiKey = !showApiKey">
                                <i class="bi @(showApiKey ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        </div>
                        <div class="form-text text-secondary small">
                            Obtenez votre clé gratuitement sur <a href="https://aistudio.google.com/apikey" target="_blank" class="text-info text-decoration-none">Google AI Studio</a>.
                            <em>(Si vide, le bot sélectionne et formate les articles sans passer par l'IA).</em>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Modèle Gemini</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="settings.GeminiModel">
                            <option value="gemini-flash-latest">gemini-flash-latest (Recommandé)</option>
                            <option value="gemini-3.8-flash">gemini-3.8-flash</option>
                            <option value="gemini-flash-lite-latest">gemini-flash-lite-latest (Rapide)</option>
                            <option value="gemini-pro-latest">gemini-pro-latest</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Nombre d'articles</label>
                        <input type="number" min="3" max="15" class="form-control bg-dark text-light border-secondary" @bind="settings.MaxArticles" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions finales -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-2">
        <button class="btn btn-outline-info px-4 py-2" @onclick="TestSendAsync" disabled="@isTesting">
            @if (isTesting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Génération et envoi en cours...</span>
            }
            else
            {
                <i class="bi bi-send me-1"></i>
                <span>Tester l'envoi maintenant</span>
            }
        </button>

        <button class="btn btn-discord px-5 py-2 fw-semibold" @onclick="SaveSettingsAsync">
            <i class="bi bi-save me-1"></i> Enregistrer les paramètres
        </button>
    </div>
</div>

@code {
    private TechWatchSettingsDto settings = new();
    private string? newTopic;
    private string? newRssFeedUrl;
    private bool showApiKey = false;
    private bool isTesting = false;
    private string? feedbackMessage;
    private bool isSuccessFeedback = true;
    private string? testPreviewContent;

    protected override void OnInitialized()
    {
        settings = ConfigService.GetSettings();
    }

    private void ToggleDay(DayOfWeek day)
    {
        if (settings.ScheduleDays.Contains(day))
        {
            if (settings.ScheduleDays.Count > 1)
            {
                settings.ScheduleDays.Remove(day);
            }
        }
        else
        {
            settings.ScheduleDays.Add(day);
        }
    }

    private string GetDayLabel(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Lun",
        DayOfWeek.Tuesday => "Mar",
        DayOfWeek.Wednesday => "Mer",
        DayOfWeek.Thursday => "Jeu",
        DayOfWeek.Friday => "Ven",
        DayOfWeek.Saturday => "Sam",
        DayOfWeek.Sunday => "Dim",
        _ => day.ToString()
    };

    private void AddTopic()
    {
        if (!string.IsNullOrWhiteSpace(newTopic))
        {
            var cleaned = newTopic.Trim().ToLowerInvariant().Replace("#", "");
            if (!settings.Topics.Contains(cleaned))
            {
                settings.Topics.Add(cleaned);
            }
            newTopic = string.Empty;
        }
    }

    private void HandleTopicKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTopic();
        }
    }

    private void RemoveTopic(string topic)
    {
        settings.Topics.Remove(topic);
    }

    private void AddCustomRss()
    {
        if (!string.IsNullOrWhiteSpace(newRssFeedUrl) && Uri.IsWellFormedUriString(newRssFeedUrl, UriKind.Absolute))
        {
            if (!settings.CustomRssFeeds.Contains(newRssFeedUrl.Trim()))
            {
                settings.CustomRssFeeds.Add(newRssFeedUrl.Trim());
            }
            newRssFeedUrl = string.Empty;
        }
    }

    private void RemoveCustomRss(string feed)
    {
        settings.CustomRssFeeds.Remove(feed);
    }

    private async Task SaveSettingsAsync()
    {
        await ConfigService.SaveSettingsAsync(settings);
        isSuccessFeedback = true;
        feedbackMessage = "Paramètres de la veille technologique enregistrés avec succès !";
    }

    private async Task TestSendAsync()
    {
        isTesting = true;
        feedbackMessage = null;
        testPreviewContent = null;
        StateHasChanged();

        try
        {
            // Sauvegarde automatique préalable
            await ConfigService.SaveSettingsAsync(settings);

            var result = await TechWatchService.ExecuteWatchAsync(isManualTest: true);
            isSuccessFeedback = result.Success;
            if (result.Success)
            {
                feedbackMessage = "Veille de test envoyée avec succès sur Discord ! Regardez vos messages.";
                testPreviewContent = result.Message;
            }
            else
            {
                feedbackMessage = $"Échec de l'envoi : {result.Message}";
            }
        }
        catch (Exception ex)
        {
            isSuccessFeedback = false;
            feedbackMessage = $"Une erreur est survenue lors du test : {ex.Message}";
        }
        finally
        {
            isTesting = false;
            StateHasChanged();
        }
    }
}
