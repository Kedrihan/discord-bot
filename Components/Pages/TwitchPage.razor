@page "/twitch"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@implements IDisposable
@inject TwitchConfigService ConfigService
@inject TwitchLiveService LiveService
@inject TwitchClipService ClipService
@inject TwitchStateService StateService
@inject TwitchEventSubService EventSubService
@inject DiscordSocketClient DiscordClient

<div class="container py-2" style="max-width: 1000px;">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-twitch text-primary me-2" style="color: #9146FF !important;"></i>Notifications Twitch Live &amp; Clips
            </h3>
            <p class="text-secondary mb-0">Alertes Discord en temps réel lorsqu'un streamer passe en direct et notifications des nouveaux clips créés.</p>
        </div>
        <div class="form-check form-switch fs-4">
            <input class="form-check-input" type="checkbox" id="enableSwitch" checked="@settings.IsEnabled" @onchange="ToggleGlobalEnabledAsync">
        </div>
    </div>

    <!-- Alertes de feedback -->
    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isSuccessFeedback ? "alert-success" : "alert-danger") alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(isSuccessFeedback ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-5"></i>
            <div class="flex-grow-1">@feedbackMessage</div>
            <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- 1. Configuration API Twitch -->
        <div class="col-lg-6">
            <div class="card p-4 h-100 shadow-sm border-secondary">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-key me-2 text-warning"></i>Identifiants API Twitch
                </h5>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Twitch Client ID</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary font-monospace"
                           placeholder="ex: gp762nuuoqcoxypju8c569th9wz7q5"
                           @bind="settings.ClientId" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Twitch Client Secret</label>
                    <div class="input-group">
                        <input type="@(showSecret ? "text" : "password")"
                               class="form-control bg-dark text-light border-secondary font-monospace"
                               placeholder="ex: abcd1234efgh5678ijkl"
                               @bind="settings.ClientSecret" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showSecret = !showSecret">
                            <i class="bi @(showSecret ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <div class="form-text text-secondary small">
                        Peuvent également être définis via <code>TWITCH_CLIENT_ID</code> et <code>TWITCH_CLIENT_SECRET</code> (.env).
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Twitch User Access Token (OAuth)</label>
                    <div class="input-group">
                        <input type="@(showUserToken ? "text" : "password")"
                               class="form-control bg-dark text-light border-secondary font-monospace"
                               placeholder="ex: oauth:abcd1234efgh5678ijkl ou token"
                               @bind="settings.UserAccessToken" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showUserToken = !showUserToken">
                            <i class="bi @(showUserToken ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <div class="form-text text-secondary small">
                        Requis pour le WebSocket EventSub temps réel (&lt; 1s). Peut être généré sans scope sur <a href="https://twitchtokengenerator.com" target="_blank" rel="noopener noreferrer" class="text-info text-decoration-none">https://twitchtokengenerator.com</a>. En l'absence de ce jeton, le mode polling automatique est actif.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Intervalle de Polling des Streams (secondes)</label>
                    <input type="number" min="15" max="3600" class="form-control bg-dark text-light border-secondary font-monospace"
                           placeholder="30"
                           @bind="settings.CheckIntervalSeconds" />
                    <div class="form-text text-secondary small">
                        Intervalle entre chaque vérification périodique lorsque le mode Polling est actif (entre 15s et 3600s, défaut : 30s).
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" id="enableClipsSwitch" checked="@settings.IsClipsEnabled" @onchange="ToggleGlobalClipsEnabledAsync">
                        <label class="form-check-label small fw-semibold text-secondary" for="enableClipsSwitch">Module de détection des clips Twitch activé</label>
                    </div>
                    <label class="form-label small fw-semibold text-secondary mt-2">Intervalle de vérification des Clips (secondes)</label>
                    <input type="number" min="15" max="3600" class="form-control bg-dark text-light border-secondary font-monospace"
                           placeholder="60"
                           @bind="settings.ClipCheckIntervalSeconds" />
                    <div class="form-text text-secondary small">
                        Intervalle entre chaque vérification des nouveaux clips (entre 15s et 3600s, défaut : 60s).
                    </div>
                </div>

                <div class="mb-0">
                    <label class="form-label small fw-semibold text-secondary">Mode de détection actif</label>
                    <div class="p-3 rounded bg-dark border border-secondary">
                        @if (EventSubService.IsConnected)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                                <span class="fw-bold text-success">EventSub WebSockets en temps réel (&lt; 1s)</span>
                            </div>
                            <div class="small text-secondary">
                                Alertes instantanées poussées par Twitch via WebSocket.
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(settings.UserAccessToken) && (EventSubService.Status == TwitchEventSubStatusDto.Connecting || EventSubService.Status == TwitchEventSubStatusDto.Reconnecting))
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
                                <span class="fw-bold text-warning">Connexion EventSub en cours...</span>
                            </div>
                            <div class="small text-secondary">
                                Établissement de la connexion WebSocket temps réel...
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-arrow-repeat text-info fs-5"></i>
                                <span class="fw-bold text-info">Mode Polling actif (@settings.CheckIntervalSeconds s)</span>
                            </div>
                            <div class="small text-secondary">
                                Vérification périodique automatique des streams toutes les @settings.CheckIntervalSeconds secondes.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Actions & État -->
        <div class="col-lg-6">
            <div class="card p-4 h-100 shadow-sm border-secondary d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-broadcast-pin me-2 text-info"></i>Statut & Actions
                    </h5>

                    <ul class="list-group list-group-flush bg-transparent mb-3">
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                            <span>Statut de détection :</span>
                            @if (EventSubService.IsConnected)
                            {
                                <span class="badge bg-success d-flex align-items-center gap-1">
                                    <span class="spinner-grow spinner-grow-sm" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                                    🟢 Connecté (EventSub temps réel &lt; 1s)
                                </span>
                            }
                            else if (EventSubService.Status == TwitchEventSubStatusDto.Connecting || EventSubService.Status == TwitchEventSubStatusDto.Reconnecting)
                            {
                                <span class="badge bg-warning text-dark">
                                    🟡 En cours de connexion...
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    🔵 Mode Polling actif (@(settings.CheckIntervalSeconds)s)
                                </span>
                            }
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                            <span>Statut du bot Discord :</span>
                            <span class="badge @(DiscordClient.ConnectionState == Discord.ConnectionState.Connected ? "bg-success" : "bg-warning")">
                                @DiscordClient.ConnectionState
                            </span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                            <span>Chaînes surveillées :</span>
                            <span class="fw-bold">@settings.Channels.Count</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                            <span>Streams actuellement en direct :</span>
                            <span class="badge @(LiveService.GetLiveStreams().Count > 0 ? "bg-danger" : "bg-secondary")">@LiveService.GetLiveStreams().Count</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
                            <span>Module Clips Twitch :</span>
                            <span class="badge @(settings.IsClipsEnabled ? "bg-success" : "bg-secondary")">
                                @(settings.IsClipsEnabled ? $"Actif ({settings.ClipCheckIntervalSeconds}s)" : "Désactivé")
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="d-flex flex-column gap-2 mt-3">
                    <button class="btn btn-primary d-flex align-items-center justify-content-center gap-2"
                            style="background-color: #9146FF; border-color: #9146FF;"
                            @onclick="SaveSettingsAsync">
                        <i class="bi bi-floppy"></i>
                        Enregistrer la configuration
                    </button>

                    <button class="btn btn-outline-info d-flex align-items-center justify-content-center gap-2"
                            disabled="@isChecking"
                            @onclick="CheckNowAsync">
                        @if (isChecking)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Vérification des streams...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-repeat"></i>
                            <span>Vérifier les streams maintenant</span>
                        }
                    </button>

                    <button class="btn btn-outline-warning d-flex align-items-center justify-content-center gap-2"
                            disabled="@isCheckingClips"
                            @onclick="CheckClipsNowAsync">
                        @if (isCheckingClips)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Vérification des clips...</span>
                        }
                        else
                        {
                            <i class="bi bi-film"></i>
                            <span>Vérifier les clips maintenant</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Gestion des chaînes suivies -->
    <div class="card p-4 shadow-sm border-secondary mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-people-fill me-2" style="color: #9146FF;"></i>Chaînes Twitch surveillées
            </h5>
            @if (!isAddingChannel && editingChannel == null)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="StartAddChannel">
                    <i class="bi bi-plus-lg me-1"></i>Ajouter une chaîne
                </button>
            }
        </div>

        <!-- Formulaire Ajout / Édition -->
        @if (isAddingChannel || editingChannel != null)
        {
            <div class="card p-3 mb-4 bg-dark border-primary">
                <h6 class="fw-bold mb-3 text-info">
                    <i class="bi @(editingChannel != null ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                    @(editingChannel != null ? "Modifier la chaîne" : "Nouvelle chaîne à surveiller")
                </h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Nom d'utilisateur Twitch</label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary text-light border-secondary">twitch.tv/</span>
                            <input type="text" class="form-control bg-dark text-light border-secondary"
                                   placeholder="zerator"
                                   @bind="formTwitchUsername" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Salon Discord cible (ID)</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary font-monospace"
                               placeholder="ex: 123456789012345678"
                               @bind="formDiscordChannelId" />
                        <div class="form-text text-secondary small">
                            ID numérique du salon Discord où envoyer l'alerte.
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold text-secondary mb-0">Message personnalisé</label>
                            <div class="small">
                                <span class="text-secondary me-1">Variables :</span>
                                <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendVariable("{streamer}")'>{streamer}</button>
                                <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendVariable("{title}")'>{title}</button>
                                <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendVariable("{game}")'>{game}</button>
                                <button type="button" class="badge bg-secondary border-0" @onclick='() => AppendVariable("{url}")'>{url}</button>
                            </div>
                        </div>
                        <textarea class="form-control bg-dark text-light border-secondary" rows="2"
                                  @bind="formCustomMessage"></textarea>
                    </div>

                    <div class="col-12 mt-3 pt-3 border-top border-secondary">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="channelClipEnableSwitch" @bind="formIsClipEnabled">
                            <label class="form-check-label small fw-semibold text-light" for="channelClipEnableSwitch">
                                <i class="bi bi-film me-1 text-warning"></i>Activer les alertes de nouveaux clips pour cette chaîne
                            </label>
                        </div>
                    </div>

                    @if (formIsClipEnabled)
                    {
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Salon Discord pour les clips (ID)</label>
                            <input type="text" class="form-control bg-dark text-light border-secondary font-monospace"
                                   placeholder="ex: 123456789012345678"
                                   @bind="formClipDiscordChannelId" />
                            <div class="form-text text-secondary small">
                                ID numérique du salon Discord où envoyer les clips.
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-semibold text-secondary mb-0">Message personnalisé pour les clips</label>
                                <div class="small">
                                    <span class="text-secondary me-1">Variables :</span>
                                    <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendClipVariable("{streamer}")'>{streamer}</button>
                                    <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendClipVariable("{creator}")'>{creator}</button>
                                    <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendClipVariable("{title}")'>{title}</button>
                                    <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendClipVariable("{duration}")'>{duration}</button>
                                    <button type="button" class="badge bg-secondary border-0 me-1" @onclick='() => AppendClipVariable("{views}")'>{views}</button>
                                    <button type="button" class="badge bg-secondary border-0" @onclick='() => AppendClipVariable("{url}")'>{url}</button>
                                </div>
                            </div>
                            <textarea class="form-control bg-dark text-light border-secondary" rows="2"
                                      @bind="formClipCustomMessage"></textarea>
                        </div>
                    }

                    <div class="col-12 d-flex justify-content-between align-items-center">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="channelEnableSwitch" @bind="formIsEnabled">
                            <label class="form-check-label small" for="channelEnableSwitch">Activer la surveillance live pour cette chaîne</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelForm">Annuler</button>
                            <button class="btn btn-sm btn-primary" style="background-color: #9146FF; border-color: #9146FF;" @onclick="SaveChannelFormAsync">
                                Enregistrer la chaîne
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Liste des chaînes -->
        @if (settings.Channels.Count == 0)
        {
            <div class="text-center py-4 text-secondary">
                <i class="bi bi-camera-video-off fs-2 d-block mb-2"></i>
                <p class="mb-0">Aucune chaîne Twitch enregistrée pour le moment. Cliquez sur "Ajouter une chaîne" pour commencer.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr class="text-secondary small">
                            <th>Statut</th>
                            <th>Chaîne Twitch</th>
                            <th>Salon Live</th>
                            <th>Salon Clips</th>
                            <th>Message Live</th>
                            <th class="text-center">Live</th>
                            <th class="text-center">Clips</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ch in settings.Channels)
                        {
                            var isLive = LiveService.IsStreamLive(ch.TwitchUsername);
                            var streamInfo = LiveService.GetLiveStreamInfo(ch.TwitchUsername);
                            var channelIdNum = ulong.TryParse(ch.DiscordChannelId, out var parsedId) ? parsedId : 0;
                            var discordChannelName = channelIdNum != 0 ? (DiscordClient.GetChannel(channelIdNum) as Discord.WebSocket.SocketGuildChannel)?.Name : null;

                            <tr>
                                <td>
                                    @if (isLive)
                                    {
                                        <span class="badge bg-danger d-inline-flex align-items-center gap-1" title="@(streamInfo != null ? $"{streamInfo.GameName} ({streamInfo.ViewerCount:N0} spectateurs)" : "En direct")">
                                            <i class="bi bi-broadcast"></i> EN DIRECT
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hors ligne</span>
                                    }
                                </td>
                                <td>
                                    <a href="https://twitch.tv/@ch.TwitchUsername" target="_blank" class="fw-bold text-decoration-none text-light d-flex align-items-center gap-1">
                                        <i class="bi bi-twitch" style="color: #9146FF;"></i>
                                        <span>@ch.TwitchUsername</span>
                                        <i class="bi bi-box-arrow-up-right small text-secondary"></i>
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-dark font-monospace border border-secondary">
                                        @(discordChannelName != null ? $"#{discordChannelName}" : ch.DiscordChannelId)
                                    </span>
                                </td>
                                <td>
                                    @if (ch.IsClipEnabled && !string.IsNullOrWhiteSpace(ch.ClipDiscordChannelId))
                                    {
                                        var clipChannelIdNum = ulong.TryParse(ch.ClipDiscordChannelId, out var parsedClipId) ? parsedClipId : 0;
                                        var discordClipChannelName = clipChannelIdNum != 0 ? (DiscordClient.GetChannel(clipChannelIdNum) as Discord.WebSocket.SocketGuildChannel)?.Name : null;
                                        <span class="badge bg-dark font-monospace border border-secondary text-info">
                                            @(discordClipChannelName != null ? $"#{discordClipChannelName}" : ch.ClipDiscordChannelId)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Désactivé</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-secondary text-truncate d-inline-block" style="max-width: 150px;" title="@ch.CustomMessage">
                                        @ch.CustomMessage
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked="@ch.IsEnabled" @onchange="() => ToggleChannelEnabledAsync(ch)" />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" checked="@ch.IsClipEnabled" @onchange="() => ToggleChannelClipEnabledAsync(ch)" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info"
                                                title="Tester l'alerte en direct"
                                                disabled="@testingChannels.Contains(ch.TwitchUsername)"
                                                @onclick="() => TestNotificationAsync(ch.TwitchUsername)">
                                            @if (testingChannels.Contains(ch.TwitchUsername))
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-broadcast"></i>
                                            }
                                        </button>
                                        <button class="btn btn-outline-warning"
                                                title="Tester la notification de clip"
                                                disabled="@(testingClipChannels.Contains(ch.TwitchUsername) || !ch.IsClipEnabled || string.IsNullOrWhiteSpace(ch.ClipDiscordChannelId))"
                                                @onclick="() => TestClipNotificationAsync(ch.TwitchUsername)">
                                            @if (testingClipChannels.Contains(ch.TwitchUsername))
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-film"></i>
                                            }
                                        </button>
                                        <button class="btn btn-outline-secondary" title="Modifier" @onclick="() => EditChannel(ch)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Supprimer" @onclick="() => RemoveChannelAsync(ch)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private TwitchSettingsDto settings = new();
    private bool showSecret = false;
    private bool showUserToken = false;
    private bool isChecking = false;
    private bool isCheckingClips = false;
    private readonly HashSet<string> testingChannels = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> testingClipChannels = new(StringComparer.OrdinalIgnoreCase);

    private string? feedbackMessage;
    private bool isSuccessFeedback = true;

    // État du formulaire d'ajout/édition
    private bool isAddingChannel = false;
    private TrackedTwitchChannelDto? editingChannel = null;
    private string formTwitchUsername = string.Empty;
    private string formDiscordChannelId = string.Empty;
    private string formCustomMessage = "🔴 **{streamer}** est en direct sur Twitch !\n{url}";
    private bool formIsEnabled = true;
    private bool formIsClipEnabled = false;
    private string formClipDiscordChannelId = string.Empty;
    private string formClipCustomMessage = "🎬 Nouveau clip de **{streamer}** créé par **{creator}** !\n{url}";

    protected override void OnInitialized()
    {
        settings = ConfigService.GetSettings();
        LiveService.OnLiveStatusChanged += HandleLiveStatusChanged;
        EventSubService.OnStatusChanged += HandleEventSubStatusChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var hasCredentials = !string.IsNullOrWhiteSpace(settings.ClientId) && !string.IsNullOrWhiteSpace(settings.ClientSecret);
        if (hasCredentials && settings.Channels.Count > 0)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await LiveService.RefreshLiveStatusAsync();
                }
                catch
                {
                    // Erreur silencieuse en arrière-plan
                }
            });
        }
    }

