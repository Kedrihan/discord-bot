    private async Task SaveChannelFormAsync()
    {
        var rawUsername = formTwitchUsername.Trim();
        if (rawUsername.StartsWith("https://twitch.tv/", StringComparison.OrdinalIgnoreCase))
        {
            rawUsername = rawUsername["https://twitch.tv/".Length..];
        }
        else if (rawUsername.StartsWith("http://twitch.tv/", StringComparison.OrdinalIgnoreCase))
        {
            rawUsername = rawUsername["http://twitch.tv/".Length..];
        }
        else if (rawUsername.StartsWith("twitch.tv/", StringComparison.OrdinalIgnoreCase))
        {
            rawUsername = rawUsername["twitch.tv/".Length..];
        }
        rawUsername = rawUsername.TrimStart('@').TrimEnd('/');

        if (string.IsNullOrWhiteSpace(rawUsername))
        {
            feedbackMessage = "Le nom d'utilisateur Twitch ne peut pas être vide.";
            isSuccessFeedback = false;
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(rawUsername, @"^[a-zA-Z0-9_]{2,30}$"))
        {
            feedbackMessage = "Le nom d'utilisateur Twitch contient des caractères non autorisés (uniquement lettres, chiffres et tirets du bas, 2 à 30 caractères).";
            isSuccessFeedback = false;
            return;
        }

        var channelIdTrimmed = formDiscordChannelId.Trim();
        if (string.IsNullOrWhiteSpace(channelIdTrimmed) || !ulong.TryParse(channelIdTrimmed, out var parsedChannelId) || parsedChannelId == 0)
        {
            feedbackMessage = "L'ID du salon Discord doit être un identifiant numérique valide (ex: 123456789012345678).";
            isSuccessFeedback = false;
            return;
        }

        var clipChannelIdTrimmed = formClipDiscordChannelId.Trim();
        if (formIsClipEnabled && (string.IsNullOrWhiteSpace(clipChannelIdTrimmed) || !ulong.TryParse(clipChannelIdTrimmed, out var parsedClipChannelId) || parsedClipChannelId == 0))
        {
            feedbackMessage = "L'ID du salon Discord pour les clips doit être un identifiant numérique valide (ex: 123456789012345678).";
            isSuccessFeedback = false;
            return;
        }

        var clipMessage = string.IsNullOrWhiteSpace(formClipCustomMessage)
            ? "🎬 Nouveau clip de **{streamer}** créé par **{creator}** !\n{url}"
            : formClipCustomMessage;

        if (editingChannel != null)
        {
            editingChannel.TwitchUsername = rawUsername;
            editingChannel.DiscordChannelId = channelIdTrimmed;
            editingChannel.CustomMessage = string.IsNullOrWhiteSpace(formCustomMessage) ? "🔴 **{streamer}** est en direct sur Twitch !\n{url}" : formCustomMessage;
            editingChannel.IsEnabled = formIsEnabled;
            editingChannel.IsClipEnabled = formIsClipEnabled;
            editingChannel.ClipDiscordChannelId = clipChannelIdTrimmed;
            editingChannel.ClipCustomMessage = clipMessage;
        }
        else
        {
            var existing = settings.Channels.FirstOrDefault(c => string.Equals(c.TwitchUsername, rawUsername, StringComparison.OrdinalIgnoreCase));
            if (existing != null)
            {
                feedbackMessage = $"La chaîne '{rawUsername}' est déjà dans la liste.";
                isSuccessFeedback = false;
                return;
            }

            settings.Channels.Add(new TrackedTwitchChannelDto
            {
                TwitchUsername = rawUsername,
                DiscordChannelId = channelIdTrimmed,
                CustomMessage = string.IsNullOrWhiteSpace(formCustomMessage) ? "🔴 **{streamer}** est en direct sur Twitch !\n{url}" : formCustomMessage,
                IsEnabled = formIsEnabled,
                IsClipEnabled = formIsClipEnabled,
                ClipDiscordChannelId = clipChannelIdTrimmed,
                ClipCustomMessage = clipMessage
            });
        }

        CancelForm();
        await SaveSettingsAsync();
        feedbackMessage = $"Chaîne '{rawUsername}' enregistrée et sauvegardée avec succès !";
        isSuccessFeedback = true;
    }

    private async Task RemoveChannelAsync(TrackedTwitchChannelDto channel)
    {
        settings.Channels.Remove(channel);
        await SaveSettingsAsync();
        feedbackMessage = $"Chaîne '{channel.TwitchUsername}' supprimée avec succès.";
        isSuccessFeedback = true;
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            settings.CheckIntervalSeconds = Math.Clamp(settings.CheckIntervalSeconds, 15, 3600);
            settings.ClipCheckIntervalSeconds = Math.Clamp(settings.ClipCheckIntervalSeconds, 15, 3600);
            await ConfigService.SaveSettingsAsync(settings);
            isSuccessFeedback = true;
            feedbackMessage = "Configuration Twitch enregistrée avec succès !";

            var hasCredentials = !string.IsNullOrWhiteSpace(settings.ClientId) && !string.IsNullOrWhiteSpace(settings.ClientSecret);
            if (hasCredentials && settings.Channels.Count > 0)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await EventSubService.ResubscribeAllAsync();
                        await LiveService.RefreshLiveStatusAsync();
                    }
                    catch
                    {
                        // Silencieux
                    }
                });
            }
        }
        catch (Exception ex)
        {
            isSuccessFeedback = false;
            feedbackMessage = $"Erreur lors de l'enregistrement : {ex.Message}";
        }
    }

    private bool _disposed;

    private async void HandleLiveStatusChanged()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Circuit may be disconnected or component disposed
        }
    }

    private async void HandleEventSubStatusChanged()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Circuit may be disconnected or component disposed
        }
    }

    public void Dispose()
    {
        _disposed = true;
        LiveService.OnLiveStatusChanged -= HandleLiveStatusChanged;
        EventSubService.OnStatusChanged -= HandleEventSubStatusChanged;
    }

